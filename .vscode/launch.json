{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 2048 游戏",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/2048_game.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
